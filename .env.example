# WorkPilot AI configuration. Copy to .env and adjust. Never commit real credentials.

NODE_ENV=development
PORT=4400
HOST=127.0.0.1
# Public address of the web app (used in email links and the Origin check).
APP_ORIGIN=http://localhost:5290

# Owner connection: runs migrations and the authentication service only.
DATABASE_URL=postgres://wp:wp_dev_password@127.0.0.1:5437/workpilot
# Restricted connection for every user request. Must be a role that does not own the tables and
# does not bypass Row Level Security (the server refuses to start otherwise).
APP_DATABASE_URL=postgres://workpilot_app:wp_app_dev_password@127.0.0.1:5437/workpilot

# Local development database (npm run db:start). Data lives outside the slow project drive.
DEV_PG_DIR=C:\workpilot-dev\pgdata
DEV_PG_PORT=5437
DEV_PG_PASSWORD=wp_dev_password
DEV_APP_PASSWORD=wp_app_dev_password

SESSION_TTL_HOURS=168
SIGNUPS_ENABLED=true
# Sign-in, sign-up, password-reset and invitation attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=30
# API requests per minute from one IP address (an office may share one) and per signed-in person.
API_IP_RATE_LIMIT=3000
API_USER_RATE_LIMIT=600
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
TRUST_PROXY=false
LOG_LEVEL=info

# Email. Without SMTP_HOST, development emails are written to ./outbox (not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=WorkPilot AI <no-reply@workpilot.local>

# Private file storage. Files are only ever downloaded through the API after an access check.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# AI assistant (read-only). none | anthropic | ollama. Without a provider the assistant says it is
# not configured; it never invents answers. Keys stay on the server.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_TIMEOUT_MS=180000
# Ollama only: keep the model in memory between questions, and load it at start-up.
OLLAMA_KEEP_ALIVE=30m
AI_WARMUP=true
