    "helmet": "^8.1.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.10",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15"
