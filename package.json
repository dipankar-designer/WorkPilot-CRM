{
  "name": "workpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkPilot AI — all-in-one workforce management: HR, projects, time tracking, team chat, project feeds and AI reports.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "npm run migrate -w @workpilot/server",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @workpilot/server\" \"npm run dev -w @workpilot/client\"",
    "dev:api": "npm run dev -w @workpilot/server",
    "dev:web": "npm run dev -w @workpilot/client",
    "admin:grant": "npm run admin:grant -w @workpilot/server --",
    "build": "npm run build -w @workpilot/server && npm run build -w @workpilot/client",
    "start": "npm run start -w @workpilot/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e-ui.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.16.3",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
